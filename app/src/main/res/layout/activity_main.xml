<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F4F8F7">

    <LinearLayout


        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textSize="32sp"
            android:textStyle="bold"
            android:textColor="#087F72" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dashboard_tagline"
            android:textSize="16sp"
            android:textColor="#526761" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/today_summary"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#17312E" />

        <TextView
            android:id="@+id/tvDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/today"
            android:textSize="16sp"
            android:textColor="#526761" />

        <TextView
            android:id="@+id/tvSteps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E0F2E9"
            android:padding="24dp"
            android:text="@string/steps_initial"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#176344" />

        <TextView
            android:id="@+id/tvCalories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FCE8E6"
            android:padding="24dp"
            android:text="@string/calories_initial"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#A83228" />

        <TextView
            android:id="@+id/tvWater"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#E3F0FC"
            android:padding="24dp"
            android:text="@string/water_initial"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#205E96" />

        <Button
            android:id="@+id/btnAddRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="24dp"
            android:minHeight="48dp"
            android:text="@string/open_add_record" />

        <Button
            android:id="@+id/btnRecordHistory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:minHeight="48dp"
            android:text="@string/record_history" />

    </LinearLayout>
</ScrollView>